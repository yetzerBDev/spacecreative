---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';

import goautos from '../images/portafolio/goautos.png';
import integramedica from '../images/portafolio/integramedica.png';
import coopdantoni from '../images/portafolio/coopdantoni.png';

const projects = [
	{
		name: 'GoAutos',
		tag: 'Vehículos',
		size: 'feature',
		copy: 'Renta ejecutiva en La Ceiba e importación directa desde subastas en EE. UU. Sin complicaciones ni depósitos abusivos.',
		image: goautos,
		alt: 'Captura del sitio de GoAutos',
		sizes: '(min-width: 900px) 56vw, 100vw',
		link: 'https://goautos.vercel.app/',
	},
	{
		name: 'Clínica Integra Médica',
		tag: 'Salud',
		size: 'side',
		copy: 'Atención médica integral, geriatría y alivio del dolor crónico en La Ceiba, con rigor científico, respeto y calidez humana.',
		image: integramedica,
		alt: 'Captura del sitio de Clínica Integra Médica',
		sizes: '(min-width: 900px) 40vw, 100vw',
		link: 'https://demo-clinica-integra.vercel.app/',
	},
	{
		name: 'Cooperativa Dantoni',
		tag: 'Ahorro y crédito',
		size: 'wide',
		copy: 'Cooperativa de ahorro y crédito ubicada en La Ceiba, Honduras, al servicio de sus asociados.',
		image: coopdantoni,
		alt: 'Captura del sitio de Cooperativa Dantoni',
		sizes: '(min-width: 900px) 92vw, 100vw',
		link: 'https://demo-dantoni-coop.vercel.app/',
	},
];
---

<section class="portfolio" id="portafolio">
	<div class="portfolio-inner">
		<header class="portfolio-head">
			<p class="kicker">Portafolio de proyectos</p>
			<h2 class="portfolio-title">Demostraciones y proyectos recientes</h2>
			<p class="portfolio-lede">
				Sitios construidos para negocios en Honduras. Ábrelos y navégalos sin registro.
			</p>
		</header>

		<div class="portfolio-grid">
			{
				projects.map((project) => (
					<article class={`project-card size-${project.size}`}>
						<span class="project-badge">Sitio Web</span>

						<Image
							src={project.image}
							alt={project.alt}
							widths={[400, 800, 1400]}
							sizes={project.sizes}
							format="webp"
							quality={74}
							class="cover-img"
						/>

						<h3 class="project-title">{project.name}</h3>
						<p class="project-copy">{project.copy}</p>

						<div class="project-foot">
							<span class="project-tag">{project.tag}</span>
							<a class="project-link" href={project.link} target="_blank" rel="noopener noreferrer">
								<span>Ver sitio</span>
								<Icon name="hugeicons:arrow-right-01" size={14} class="link-arrow" />
							</a>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
	.portfolio {
		padding: 80px 0;
		background: var(--clr-surface-light);
		border-top: 1px solid var(--clr-line);
	}

	@media (min-width: 640px) {
		.portfolio {
			padding: 112px 0;
		}
	}

	.portfolio-inner {
		max-width: 80rem;
		margin: 0 auto;
		padding: 0 16px;
	}

	@media (min-width: 640px) {
		.portfolio-inner {
			padding: 0 24px;
		}
	}

	@media (min-width: 1024px) {
		.portfolio-inner {
			padding: 0 32px;
		}
	}

	.kicker {
		font-family: var(--font-display);
		font-size: 0.6875rem;
		font-weight: 700;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--clr-cerulean-ink);
	}

	.portfolio-head {
		max-width: 44rem;
		margin: 0 auto 56px;
		text-align: center;
	}

	@media (min-width: 640px) {
		.portfolio-head {
			margin-bottom: 64px;
		}
	}

	.portfolio-title {
		margin-top: 16px;
		font-family: var(--font-display);
		font-weight: 800;
		font-size: clamp(1.875rem, 1.2rem + 2.4vw, 2.75rem);
		line-height: 1.14;
		letter-spacing: -0.02em;
		color: var(--clr-heading);
	}

	.portfolio-lede {
		margin: 18px auto 0;
		max-width: 40rem;
		font-size: clamp(0.875rem, 0.82rem + 0.2vw, 1rem);
		line-height: 1.7;
		color: var(--clr-slate);
	}

	.portfolio-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 24px;
		align-items: stretch;
	}

	@media (min-width: 900px) {
		.portfolio-grid {
			grid-template-columns: repeat(12, 1fr);
			gap: 28px 24px;
		}

		.size-feature {
			grid-column: span 7;
		}

		.size-side {
			grid-column: span 5;
		}

		.size-wide {
			grid-column: span 12;
		}
	}

	.project-card {
		position: relative;
		display: flex;
		flex-direction: column;
		min-width: 0;
		padding: 24px;
		border-radius: var(--radius-panel);
		background: #ffffff;
		border: 1px solid rgba(203, 213, 225, 0.8);
		box-shadow: 0 1px 2px rgba(11, 37, 69, 0.04);
		transition:
			transform 200ms var(--ease-out),
			box-shadow 200ms var(--ease-out),
			border-color 200ms var(--ease-out);
	}

	@media (hover: hover) and (pointer: fine) {
		.project-card:hover {
			transform: translateY(-3px);
			box-shadow: 0 24px 44px -24px rgba(11, 37, 69, 0.35);
			border-color: rgba(148, 163, 184, 0.9);
		}
	}

	.project-badge {
		position: absolute;
		top: 36px;
		left: 36px;
		z-index: var(--z-content);
		padding: 5px 11px;
		border-radius: var(--radius-pill);
		background: var(--clr-cerulean-ink);
		color: #ffffff;
		font-family: var(--font-display);
		font-size: 0.625rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.cover-img {
		flex: 0 0 auto;
		display: block;
		width: 100%;
		min-width: 0;
		height: auto;
		aspect-ratio: 2 / 1;
		object-fit: cover;
		object-position: top center;
		margin-bottom: 20px;
		border: 1px solid rgba(203, 213, 225, 0.8);
		border-radius: var(--radius-inner);
		background: #eef2f7;
	}

	.size-wide .cover-img {
		aspect-ratio: 2.4 / 1;
	}

	.project-title {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: 1.0625rem;
		line-height: 1.3;
		letter-spacing: -0.01em;
		color: var(--clr-heading);
	}

	.project-copy {
		margin-top: 10px;
		font-size: 0.8125rem;
		line-height: 1.65;
		color: var(--clr-slate);
	}

	.project-foot {
		margin-top: auto;
		padding-top: 16px;
		border-top: 1px solid #eef2f7;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
	}

	.project-tag {
		font-size: 0.6875rem;
		font-weight: 600;
		color: var(--clr-heading);
	}

	.project-link {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: 0.6875rem;
		font-weight: 700;
		color: var(--clr-cerulean-ink);
		text-decoration: none;
		border-radius: 4px;
	}

	.project-link:hover {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
	}

	.project-link:focus-visible {
		outline: 2px solid var(--clr-cerulean-ink);
		outline-offset: 3px;
	}

	.link-arrow {
		transition: transform 180ms var(--ease-out);
	}

	@media (hover: hover) and (pointer: fine) {
		.project-link:hover .link-arrow {
			transform: translateX(3px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.project-card,
		.link-arrow {
			transition: none;
		}
	}

	@media (prefers-reduced-motion: reduce) and (hover: hover) and (pointer: fine) {
		.project-card:hover {
			transform: none;
		}

		.project-link:hover .link-arrow {
			transform: none;
		}
	}
</style>