---
import { Image } from 'astro:assets';
import dantoni from '../logos/dantoni.png';
import valtech from '../logos/valtech.png';
import lexterra from '../logos/lexterra.png';
import orthodent from '../logos/orthodent.png';

const clients = [
	{ name: 'Dantoni', logo: dantoni },
	{ name: 'Valtech', logo: valtech },
	{ name: 'Lexterra', logo: lexterra },
	{ name: 'Orthodent', logo: orthodent },
];
---

<section class="logo-strip" aria-label="Empresas que confían en Space Creative" data-reveal>
	<p class="logo-strip-label">Respaldando empresas, marcas y proyectos en Honduras y la región</p>

	<div class="logo-row">
		{
			clients.map((client) => (
				<div class="logo-item">
					<Image src={client.logo} alt={client.name} inferSize class="logo-img" />
				</div>
			))
		}
	</div>
</section>

<style>
	.logo-strip {
		position: relative;
		z-index: 20;
		background: #f4f7ff;
		border-top: 1px solid rgba(10, 42, 102, 0.14);
		border-bottom: 1px solid rgba(10, 42, 102, 0.14);
		padding: 36px 0;
	}

	@media (min-width: 640px) {
		.logo-strip {
			padding: 48px 0;
		}
	}

	.logo-strip-label {
		max-width: 80rem;
		margin: 0 auto 28px;
		padding: 0 16px;
		text-align: center;
		font-family: 'DM Sans', system-ui, sans-serif;
		font-size: 0.9375rem;
		font-weight: 400;
		color: #4a5a8c;
	}

	.logo-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 32px;
		padding: 0 24px;
	}

	@media (min-width: 640px) {
		.logo-row {
			gap: 48px 72px;
		}
	}

	.logo-item {
		display: inline-flex;
		align-items: center;
		filter: grayscale(1);
		opacity: 0.55;
		transition: filter 200ms ease, opacity 200ms ease;
	}

	@media (hover: hover) and (pointer: fine) {
		.logo-item:hover {
			filter: grayscale(0);
			opacity: 1;
		}
	}

	.logo-item :global(img) {
		height: 34px;
		width: auto;
		display: block;
	}

	@media (min-width: 640px) {
		.logo-item :global(img) {
			height: 48px;
		}
	}

	@media (max-width: 480px) {
		.logo-strip-label {
			margin-bottom: 22px;
			font-size: 0.875rem;
			line-height: 1.5;
			max-width: 22rem;
		}

		.logo-row {
			gap: 28px 20px;
		}
	}
</style>