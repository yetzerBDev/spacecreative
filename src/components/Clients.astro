---
import { Image } from 'astro:assets';
import dantoni from '../logos/dantoni.png';
import valtech from '../logos/valtech.png';
import lexterra from '../logos/lexterra.png';

const clients = [
	{ name: 'Dantoni', logo: dantoni },
	{ name: 'Valtech', logo: valtech },
	{ name: 'Lexterra', logo: lexterra },
];
---

<section class="logo-strip" aria-label="Empresas que confían en Space Creative">
	<p class="logo-strip-label">Respaldando empresas, marcas y proyectos en Honduras y la región</p>

	<div class="logo-row">
		{
			clients.map((client) => (
				<div class="logo-item">
					<Image src={client.logo} alt={client.name} inferSize class="logo-img" />
				</div>
			))
		}
	</div>
</section>

<style>
	.logo-strip {
		position: relative;
		z-index: 20;
		background: var(--clr-surface-light);
		border-bottom: 1px solid var(--clr-line);
		padding: 40px 0;
	}

	@media (min-width: 640px) {
		.logo-strip {
			padding: 48px 0;
		}
	}

	.logo-strip-label {
		max-width: 80rem;
		margin: 0 auto 28px;
		padding: 0 16px;
		text-align: center;
		font-family: var(--font-display);
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--clr-slate);
	}

	.logo-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 48px 72px;
		padding: 0 24px;
	}

	.logo-item {
		display: inline-flex;
		align-items: center;
		filter: grayscale(1);
		opacity: 0.55;
		transition: filter 200ms ease, opacity 200ms ease;
	}

	@media (hover: hover) and (pointer: fine) {
		.logo-item:hover {
			filter: grayscale(0);
			opacity: 1;
		}
	}

	.logo-item :global(img) {
		height: 40px;
		width: auto;
		display: block;
	}

	@media (min-width: 640px) {
		.logo-item :global(img) {
			height: 48px;
		}
	}
</style>