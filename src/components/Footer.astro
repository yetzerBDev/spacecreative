---
import WhatsAppIcon from './WhatsAppIcon.astro';
import logoUrl from '../../logo.png';

const navLinks = [
	{ href: '#inicio', label: 'Inicio' },
	{ href: '#nosotros', label: 'Por qué nosotros' },
	{ href: '#servicios', label: 'Servicios' },
	{ href: '#portafolio', label: 'Portafolio' },
	{ href: '#proceso', label: 'Proceso de trabajo' },
];

const serviceLinks = [
	{ href: '#servicios-web', label: 'Desarrollo web' },
	{ href: '#servicios-movil', label: 'Desarrollo móvil' },
	{ href: '#servicios-backend', label: 'Arquitectura backend' },
	{ href: '#servicios-redes', label: 'Manejo de redes' },
];

const waLink = 'https://wa.me/50493828622?text=Hola%20Space%20Creative,%20quiero%20cotizar%20un%20proyecto';
---

<footer class="footer">
	<div class="footer-inner">
		<div class="footer-grid">
			<div class="brand-col">
				<a class="brand-link" href="#inicio" aria-label="Space Creative, ir al inicio">
					<img class="footer-logo" src={logoUrl.src} alt="Logo de Space Creative" height="40" />
				</a>
				<p class="brand-copy">
					Estudio de desarrollo web y móvil, sistemas a la medida y manejo de redes sociales para empresas en Honduras y la región.
				</p>
				<p class="brand-tag">Sueña · Crea · Avanza</p>
			</div>

			<nav class="link-col" aria-label="Navegación del sitio">
				<p class="col-title">Navegación</p>
				<ul>
					{navLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
				</ul>
			</nav>

			<nav class="link-col" aria-label="Servicios">
				<p class="col-title">Servicios</p>
				<ul>
					{serviceLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
				</ul>
			</nav>

			<div class="contact-col">
				<p class="col-title">Contacto</p>
				<p class="contact-place">La Ceiba, Atlántida</p>
				<p class="contact-country">Honduras, Centroamérica</p>
				<a class="contact-link" href="mailto:contacto@spacecreative.io">contacto@spacecreative.io</a>
				<a class="wa-link" href={waLink} target="_blank" rel="noopener noreferrer">
					<WhatsAppIcon size={16} />
					<span>+504 9382-8622</span>
				</a>
				<p class="contact-note">Respuesta en menos de 24 horas laborables.</p>
			</div>
		</div>

		<div class="sub-footer">
			<p>© 2026 Space Creative. Todos los derechos reservados.</p>
			<a class="sub-link" href="#contacto">Cotizar proyecto</a>
		</div>
	</div>
</footer>

<style>
	.footer {
		position: relative;
		overflow: hidden;
		padding: 72px 0 40px;
		background: var(--clr-abyss);
	}

	.footer::before {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		background: radial-gradient(50% 55% at 88% 0%, rgba(0, 162, 253, 0.1), transparent 70%);
	}

	@media (min-width: 640px) {
		.footer {
			padding: 88px 0 48px;
		}
	}

	.footer-inner {
		position: relative;
		z-index: var(--z-content);
		max-width: 80rem;
		margin: 0 auto;
		padding: 0 16px;
	}

	@media (min-width: 640px) {
		.footer-inner {
			padding: 0 24px;
		}
	}

	@media (min-width: 1024px) {
		.footer-inner {
			padding: 0 32px;
		}
	}

	.footer-grid {
		display: grid;
		gap: 44px;
	}

	@media (min-width: 768px) {
		.footer-grid {
			grid-template-columns: repeat(5, 1fr);
			gap: 40px;
		}

		.brand-col {
			grid-column: span 2;
		}
	}

	.brand-link {
		display: inline-flex;
		align-items: center;
	}

	.footer-logo {
		height: 40px;
		width: auto;
		display: block;
		object-fit: contain;
	}

	.brand-copy {
		max-width: 26rem;
		margin-top: 22px;
		font-size: 0.8125rem;
		line-height: 1.75;
		color: #9aa8bd;
	}

	.brand-tag {
		margin-top: 20px;
		font-family: var(--font-display);
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: #7cc6ff;
	}

	.col-title {
		font-family: var(--font-display);
		font-size: 0.6875rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: #ffffff;
	}

	.link-col ul {
		list-style: none;
		margin-top: 20px;
		display: flex;
		flex-direction: column;
		gap: 13px;
	}

	.link-col a,
	.sub-link {
		font-size: 0.8125rem;
		color: #9aa8bd;
		text-decoration: none;
		transition: color 160ms ease;
	}

	.link-col a:hover,
	.sub-link:hover {
		color: #ffffff;
	}

	.link-col a:focus-visible,
	.sub-link:focus-visible,
	.contact-link:focus-visible,
	.wa-link:focus-visible,
	.brand-link:focus-visible {
		outline: 2px solid #7cc6ff;
		outline-offset: 3px;
		border-radius: 4px;
	}

	.contact-place {
		margin-top: 20px;
		font-size: 0.8125rem;
		font-weight: 500;
		color: #cbd6e4;
	}

	.contact-country {
		margin-top: 4px;
		font-size: 0.8125rem;
		color: #9aa8bd;
	}

	.contact-link {
		display: inline-block;
		margin-top: 14px;
		font-size: 0.8125rem;
		color: #9aa8bd;
		text-decoration: none;
		transition: color 160ms ease;
	}

	.contact-link:hover {
		color: #ffffff;
	}

	.wa-link {
		display: inline-flex;
		align-items: center;
		gap: 9px;
		margin-top: 18px;
		padding: 9px 16px;
		border: 1px solid rgba(148, 163, 184, 0.28);
		border-radius: var(--radius-pill);
		background: rgba(255, 255, 255, 0.03);
		font-family: var(--font-display);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		color: #e6eefb;
		text-decoration: none;
		transition:
			border-color 180ms ease,
			background-color 180ms ease;
	}

	.wa-link [data-icon] {
		color: #4ade80;
	}

	.wa-link:hover {
		border-color: rgba(148, 163, 184, 0.55);
		background: rgba(255, 255, 255, 0.07);
	}

	.contact-note {
		margin-top: 16px;
		max-width: 18rem;
		font-size: 0.75rem;
		line-height: 1.6;
		color: #7f8ea8;
	}

	.sub-footer {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 12px;
		margin-top: 64px;
		padding-top: 28px;
		border-top: 1px solid rgba(148, 163, 184, 0.14);
		font-size: 0.75rem;
		color: #8b9bb4;
		text-align: center;
	}

	@media (min-width: 640px) {
		.sub-footer {
			flex-direction: row;
			justify-content: space-between;
			text-align: left;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.link-col a,
		.sub-link,
		.contact-link,
		.wa-link {
			transition: none;
		}
	}
</style>