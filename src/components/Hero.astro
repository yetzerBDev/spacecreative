---
const waLink =
	'https://wa.me/50493828622?text=Hola%20Space%20Creative,%20quiero%20cotizar%20un%20proyecto';
---

<header id="inicio" class="frame">
	<div class="wrap">
		<nav aria-label="Navegación principal">
			<a class="brand" href="#inicio"><span class="mark" aria-hidden="true"><i></i></span>Space Creative</a>
			<div class="links">
				<a href="#servicios">Servicios</a>
				<a href="#nosotros">Por qué nosotros</a>
				<a href="#proceso">Metodología</a>
				<a href="#contacto">Contacto</a>
			</div>
		</nav>

		<div class="hero">
			<div>
				<h1 class="in">Desarrollo web a la medida de tu negocio</h1>
				<p class="lead in d1">Sitios y plataformas pensados para vender y captar clientes reales.</p>
				<div class="actions in d2">
					<a class="btn" href={waLink} target="_blank" rel="noopener noreferrer">
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.5 0-3-.4-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.200Zm4.5-6.100c-.2-.1-1.500-.7-1.700-.8s-.4-.1-.6.100-.6.800-.8 1-.3.200-.5.100a6.700 6.700 0 0 1-3.300-2.900c-.2-.4.200-.4.700-1.300.1-.2 0-.3 0-.4l-.8-1.800c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.300 3 3 0 0 0-.9 2.200 5.300 5.300 0 0 0 1.100 2.800 12 12 0 0 0 4.600 4c1.700.7 2.400.8 3.200.7.500-.1 1.500-.6 1.700-1.200s.2-1.100.2-1.200-.2-.2-.4-.3Z"/></svg>
						Cotiza tu proyecto
					</a>
					<a class="text-link" href="#servicios">Ver servicios</a>
				</div>
			</div>

			<div class="stage in d3" aria-hidden="true">
				<div class="browser">
					<div class="bar"><div class="url"></div></div>
					<div class="page">
						<div class="s h"></div><div class="s w"></div><div class="s n"></div>
						<div class="pill"></div>
						<div class="tiles"><b></b><b></b><b></b></div>
					</div>
				</div>
				<div class="chip">
					<svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 0 0-8.600 15.100L2 22l5-1.300A10 10 0 1 0 12 2Z"/></svg>
					<span><strong>Nueva cotización</strong>desde tu sitio web</span>
				</div>
			</div>
		</div>
	</div>
</header>

<style>
	.frame {
		--bg: #f4f7ff;
		--surface: #fff;
		--text: #0a2a66;
		--muted: #4a5a8c;
		--line: rgba(10, 42, 102, 0.14);
		--cta: #2bd576;
		--cta-ink: #04210f;
		--ease: cubic-bezier(0.23, 1, 0.32, 1);

		min-height: 100%;
		background: var(--bg);
		color: var(--text);
		font-family: 'DM Sans', system-ui, sans-serif;
		-webkit-font-smoothing: antialiased;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	a:focus-visible {
		outline: 2px solid var(--text);
		outline-offset: 3px;
		border-radius: 8px;
	}

	.wrap {
		max-width: 1180px;
		margin: 0 auto;
		padding: 0 24px;
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 76px;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 10px;
		font: 600 1.05rem 'Sora', sans-serif;
		letter-spacing: -0.01em;
	}

	.mark {
		width: 30px;
		height: 30px;
		border-radius: 9px;
		background: var(--text);
		display: grid;
		place-items: center;
	}

	.mark i {
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: var(--surface);
		box-shadow: 7px -7px 0 -3px var(--cta);
	}

	.links {
		display: flex;
		gap: 32px;
		font-size: 0.95rem;
		color: var(--muted);
	}

	.links a {
		transition: color 0.16s ease-out;
	}

	.hero {
		display: grid;
		grid-template-columns: 1.05fr 0.95fr;
		gap: 56px;
		align-items: center;
		min-height: calc(100vh - 76px);
		min-height: calc(100svh - 76px);
		padding: 24px 0 72px;
	}

	h1 {
		font: 600 clamp(2.5rem, 5.4vw, 4.4rem)/1.02 'Sora', sans-serif;
		letter-spacing: -0.04em;
		margin: 0;
		max-width: 14ch;
	}

	.lead {
		font-size: 1.2rem;
		line-height: 1.55;
		color: var(--muted);
		max-width: 34ch;
		margin: 24px 0 36px;
	}

	.actions {
		display: flex;
		align-items: center;
		gap: 28px;
		flex-wrap: wrap;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		background: var(--cta);
		color: var(--cta-ink);
		font-weight: 500;
		padding: 15px 24px;
		border-radius: 999px;
		transition:
			transform 0.16s var(--ease),
			filter 0.16s ease-out;
	}

	.btn:active {
		transform: scale(0.97);
	}

	.btn svg {
		width: 18px;
		height: 18px;
		fill: currentColor;
	}

	.text-link {
		color: var(--text);
		border-bottom: 1px solid var(--line);
		padding-bottom: 2px;
		transition: border-color 0.16s ease-out;
	}

	/* maqueta del sitio */
	.stage {
		position: relative;
	}

	.browser {
		background: var(--surface);
		border-radius: 18px;
		box-shadow: 0 40px 70px -28px rgba(10, 42, 102, 0.3);
		overflow: hidden;
	}

	.bar {
		height: 42px;
		border-bottom: 1px solid #e6ebf4;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.url {
		width: 44%;
		height: 18px;
		border-radius: 9px;
		background: #eef2f9;
	}

	.page {
		padding: 26px;
		display: grid;
		gap: 14px;
	}

	.s {
		height: 12px;
		border-radius: 6px;
		background: #e6ebf4;
	}

	.s.h {
		height: 20px;
		width: 62%;
		background: var(--text);
	}

	.s.w {
		width: 84%;
	}

	.s.n {
		width: 56%;
	}

	.pill {
		width: 116px;
		height: 34px;
		border-radius: 999px;
		background: var(--cta);
		margin-top: 6px;
	}

	.tiles {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 12px;
		margin-top: 10px;
	}

	.tiles b {
		height: 92px;
		border-radius: 12px;
		background: #eaf0ff;
	}

	.tiles b:nth-child(2) {
		background: #d5e2ff;
	}

	.tiles b:nth-child(3) {
		background: #f1f4fa;
	}

	.chip {
		position: absolute;
		right: -14px;
		bottom: -22px;
		display: flex;
		align-items: center;
		gap: 12px;
		background: var(--cta);
		color: var(--cta-ink);
		padding: 14px 18px;
		border-radius: 16px;
		font-size: 0.92rem;
		line-height: 1.3;
		box-shadow: 0 18px 36px -14px rgba(10, 42, 102, 0.4);
	}

	.chip svg {
		width: 22px;
		height: 22px;
		fill: currentColor;
		flex: none;
	}

	.chip strong {
		font-weight: 500;
		display: block;
	}

	@media (hover: hover) and (pointer: fine) {
		.links a:hover {
			color: var(--text);
		}

		.btn:hover {
			filter: brightness(1.06);
		}

		.text-link:hover {
			border-color: var(--text);
		}
	}

	/* una sola entrada al cargar */
	@keyframes up {
		from {
			opacity: 0;
			transform: translateY(12px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	.in {
		animation: up 0.42s var(--ease) both;
	}

	.d1 {
		animation-delay: 0.06s;
	}

	.d2 {
		animation-delay: 0.12s;
	}

	.d3 {
		animation-delay: 0.2s;
	}

	@media (prefers-reduced-motion: reduce) {
		.in {
			animation: none;
		}

		.btn,
		.links a,
		.text-link {
			transition: none;
		}
	}

	@media (max-width: 900px) {
		.links a:not(:last-child) {
			display: none;
		}

		.hero {
			grid-template-columns: 1fr;
			gap: 48px;
			min-height: 0;
			padding-top: 32px;
		}

		.chip {
			right: 8px;
		}
	}
</style>
