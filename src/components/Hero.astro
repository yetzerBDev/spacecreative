---
import WhatsAppIcon from './WhatsAppIcon.astro';
import logoUrl from '../../logo.png';

const waLink = 'https://wa.me/50493828622?text=Hola%20Space%20Creative,%20quiero%20cotizar%20un%20proyecto';

const navLinks = [
	{ href: '#servicios', label: 'Servicios' },
	{ href: '#portafolio', label: 'Portafolio' },
	{ href: '#contacto', label: 'Contacto' },
];
---

<header class="hero" id="inicio">
	<div class="hero-inner">
		<nav class="nav" aria-label="Navegación principal">
			<a class="nav-logo" href="#inicio" title="Space Creative" aria-label="Space Creative, ir al inicio">
				<span class="logo" style={`--logo-src: url(${logoUrl.src})`}></span>
			</a>

			<ul class="nav-links">
				{
					navLinks.map((link) => (
						<li>
							<a href={link.href}>{link.label}</a>
						</li>
					))
				}
			</ul>

			<a class="btn btn-nav" href={waLink} target="_blank" rel="noopener noreferrer">
				<WhatsAppIcon size={16} />
				<span>Cotizar por WhatsApp</span>
			</a>
		</nav>

		<div class="hero-grid">
			<div class="hero-copy">
				<h1 class="hero-title in">Desarrollo web a la medida de tu negocio</h1>

				<p class="hero-lead in d1">
					Sitios y plataformas pensados para vender y captar clientes reales.
				</p>

				<div class="hero-actions in d2">
					<a class="btn btn-primary" href={waLink} target="_blank" rel="noopener noreferrer">
						<WhatsAppIcon size={18} />
						<span>Cotiza tu proyecto</span>
					</a>
					<a class="text-link" href="#servicios">Ver servicios</a>
				</div>
			</div>

			<div class="stage in d3" aria-hidden="true">
				<div class="browser">
					<div class="bar"><span class="url"></span></div>
					<div class="page">
						<span class="s s-h"></span>
						<span class="s s-w"></span>
						<span class="s s-n"></span>
						<span class="pill"></span>
						<span class="tiles">
							<i></i>
							<i></i>
							<i></i>
						</span>
					</div>
				</div>

				<div class="chip">
					<WhatsAppIcon size={20} />
					<span>
						<strong>Nueva cotización</strong>
						desde tu sitio web
					</span>
				</div>
			</div>
		</div>
	</div>
</header>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		background: #ffffff;
		border-bottom: 1px solid var(--clr-line);
	}

	.hero::before {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		background:
			radial-gradient(58% 62% at 86% 16%, rgba(0, 162, 253, 0.09), transparent 72%),
			linear-gradient(180deg, #ffffff 0%, #ffffff 58%, #f5f8ff 100%);
	}

	.hero-inner {
		position: relative;
		z-index: var(--z-content);
		max-width: 80rem;
		margin: 0 auto;
		padding: 0 16px;
	}

	@media (min-width: 640px) {
		.hero-inner {
			padding: 0 24px;
		}
	}

	@media (min-width: 1024px) {
		.hero-inner {
			padding: 0 32px;
		}
	}

	.nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		height: 76px;
	}

	.nav-logo {
		display: flex;
		align-items: center;
	}

	.logo {
		display: block;
		--logo-h: 40px;
		height: var(--logo-h);
		width: calc(var(--logo-h) * 3.737);
		background-color: var(--clr-heading);
		-webkit-mask: var(--logo-src) center / contain no-repeat;
		mask: var(--logo-src) center / contain no-repeat;
		transition: opacity 160ms ease;
	}

	@media (min-width: 640px) {
		.logo {
			--logo-h: 46px;
		}
	}

	.nav-links {
		display: none;
		list-style: none;
		align-items: center;
		gap: 32px;
	}

	@media (min-width: 1024px) {
		.nav-links {
			display: flex;
		}
	}

	.nav-links a {
		font-family: var(--font-body);
		font-size: 0.9375rem;
		font-weight: 500;
		color: var(--clr-slate);
		text-decoration: none;
		transition: color 160ms ease;
	}

	.hero-grid {
		display: grid;
		grid-template-columns: 1fr;
		align-items: center;
		gap: 48px;
		padding: 32px 0 72px;
	}

	@media (min-width: 901px) {
		.hero-grid {
			grid-template-columns: 1.05fr 0.95fr;
			gap: 56px;
			min-height: calc(100vh - 76px);
			min-height: calc(100svh - 76px);
			padding: 24px 0 72px;
		}
	}

	.hero-title {
		max-width: 14ch;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: clamp(2.1rem, 5.4vw, 4.4rem);
		line-height: 1.02;
		letter-spacing: -0.03em;
		color: var(--clr-heading);
	}

	.hero-lead {
		max-width: 34ch;
		margin-top: 24px;
		font-size: clamp(1rem, 0.95rem + 0.3vw, 1.2rem);
		line-height: 1.55;
		color: var(--clr-body);
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 28px;
		margin-top: 36px;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 9px;
		border-radius: var(--radius-pill);
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 0.9375rem;
		text-decoration: none;
		color: #ffffff;
		cursor: pointer;
		user-select: none;
		transition:
			transform 160ms var(--ease-out),
			background-color 160ms ease;
	}

	.btn:active {
		transform: scale(0.97);
	}

	.btn:focus-visible {
		outline: 3px solid var(--clr-cerulean-ink);
		outline-offset: 3px;
	}

	.btn-nav {
		font-size: 0.8125rem;
		padding: 11px 18px;
		background: var(--clr-wa);
	}

	.btn-primary {
		padding: 15px 26px;
		background: var(--clr-wa);
		box-shadow: 0 14px 26px -14px rgba(20, 107, 66, 0.7);
	}

	.text-link {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding-bottom: 3px;
		border-bottom: 1px solid rgba(11, 37, 69, 0.3);
		color: var(--clr-heading);
		font-family: var(--font-display);
		font-size: 0.9375rem;
		font-weight: 600;
		text-decoration: none;
		transition: border-color 160ms ease;
	}

	.text-link:focus-visible {
		outline: 2px solid var(--clr-cerulean-ink);
		outline-offset: 4px;
		border-radius: 4px;
	}

	.stage {
		position: relative;
		max-width: 560px;
	}

	.browser {
		position: relative;
		background: #ffffff;
		border: 1px solid rgba(203, 213, 225, 0.9);
		border-radius: var(--radius-panel);
		overflow: hidden;
		box-shadow: 0 40px 70px -36px rgba(11, 37, 69, 0.5);
	}

	.bar {
		display: flex;
		align-items: center;
		justify-content: center;
		height: 42px;
		border-bottom: 1px solid #e6ebf4;
		background: #f8fafd;
	}

	.url {
		display: block;
		width: 44%;
		height: 18px;
		border-radius: var(--radius-pill);
		background: #eef2f9;
	}

	.page {
		display: grid;
		gap: 14px;
		padding: 26px;
	}

	.s {
		display: block;
		height: 12px;
		border-radius: 6px;
		background: #e6ebf4;
	}

	.s-h {
		height: 20px;
		width: 62%;
		background: var(--clr-deep);
	}

	.s-w {
		width: 84%;
	}

	.s-n {
		width: 56%;
	}

	.pill {
		display: block;
		width: 116px;
		height: 34px;
		margin-top: 6px;
		border-radius: var(--radius-pill);
		background: var(--clr-wa);
	}

	.tiles {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 12px;
		margin-top: 10px;
	}

	.tiles i {
		display: block;
		height: 92px;
		border-radius: var(--radius-inner);
		background: #eaf0ff;
	}

	.tiles i:nth-child(2) {
		background: #d5e2ff;
	}

	.tiles i:nth-child(3) {
		background: #f1f4fa;
	}

	.chip {
		position: absolute;
		right: -14px;
		bottom: -22px;
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 14px 18px;
		border-radius: var(--radius-inner);
		background: var(--clr-wa);
		color: #ffffff;
		font-size: 0.92rem;
		line-height: 1.3;
		box-shadow: 0 18px 36px -16px rgba(11, 37, 69, 0.55);
	}

	.chip strong {
		display: block;
		font-family: var(--font-display);
		font-weight: 700;
	}

	@media (max-width: 900px) {
		.stage {
			max-width: 100%;
		}

		.chip {
			right: 8px;
		}
	}

	@media (max-width: 639px) {
		.btn-nav {
			padding: 11px;
		}

		.btn-nav span {
			display: none;
		}
	}

	@media (hover: hover) and (pointer: fine) {
		.nav-logo:hover .logo {
			opacity: 0.72;
		}

		.nav-links a:hover {
			color: var(--clr-heading);
		}

		.btn:hover {
			background: var(--clr-wa-hover);
		}

		.text-link:hover {
			border-color: var(--clr-heading);
		}
	}

	.in {
		animation: heroUp 420ms var(--ease-out) both;
	}

	.d1 {
		animation-delay: 60ms;
	}

	.d2 {
		animation-delay: 120ms;
	}

	.d3 {
		animation-delay: 200ms;
	}

	@keyframes heroUp {
		from {
			opacity: 0;
			transform: translateY(12px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.in {
			animation: none;
		}

		.logo,
		.btn,
		.nav-links a,
		.text-link {
			transition: none;
		}
	}
</style>